# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local debug/preview artifacts, not part of the source
.playwright-mcp/
_vercel-live-mirror/
_dev-check/

# env files: keep the documented example
!.env.example

# Payload local file storage (development and tests)
/media/
/manuscripts/
/.test-uploads/

# local screenshots for visual checks
/.screenshots/

# client correspondence and the signed proposal: business records, not source
/refs/
/docs/*.pdf
/docs/*.docx
/docs/*.html
